# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used by `npm run db:setup` (never exposed to the browser).
# Supabase dashboard -> Connect -> Session pooler connection string, with your DB password filled in.
# URL-encode special characters in the password (e.g. spaces -> %20).
DATABASE_URL=

# Optional: your own TURN server for reliable screen share behind strict
# firewalls/NATs. Leave empty to use the built-in free Open Relay TURN fallback.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
